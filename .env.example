# ==============================================================================
# OpenTrack OS - Environment Configuration (Optional)
# OpenTrack OS is 100% functional out-of-the-box with ZERO configuration.
# All map tiles (OpenStreetMap) and routing services (OSRM) run out-of-the-box.
# ==============================================================================

# Optional Self-Hosted OSRM Instance (Defaults to public OSRM router)
# NEXT_PUBLIC_OSRM_URL=https://router.project-osrm.org

# Optional Default Map Center Coordinates
# NEXT_PUBLIC_DEFAULT_LAT=30.0444
# NEXT_PUBLIC_DEFAULT_LNG=31.2357
